# API mode requires compatible chat and embedding endpoints. No keys in source code.
MODEL_MODE=api
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=https://your-provider.example/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
# Empty = embedded persistent Qdrant, suitable for a single local process.
QDRANT_URL=
DATA_DIR=data
# Optional endpoint implementing POST /rerank with results[index,relevance_score].
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# Reliability: connection/read inactivity timeout, retries only before body delivery.
MODEL_CONNECT_TIMEOUT_SECONDS=10
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_RETRY_MAX_DELAY_SECONDS=5
MODEL_STREAM_MAX_SECONDS=180
# Docker-only host port; local scripts remain 8000 / 8001.
APP_PORT=8002
